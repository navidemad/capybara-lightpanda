+[tools]
+ruby = "4.0.4"
+node = "24.14.1"
+# yarn 4 ships via corepack-enabled node; package.json has packageManager: yarn@4.14.1
+# Postgres: using Postgres.app (system, port 5432)
+# Redis: using Homebrew redis (system, port 6379)
+# Elasticsearch: not running — chewy specs will be skipped/fail until ES is up.
+
+[env]
+# Mastodon's chewy/Elasticsearch configuration is enabled by default;
+# disable it for the test run since we don't have a local ES instance.
+ES_ENABLED = "false"
